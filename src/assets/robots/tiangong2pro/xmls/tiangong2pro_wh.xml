      <geom contype="0" conaffinity="0" group="1" density="0"/>
    </default>

    <!-- Primitive collision geometry -->
    <default class="collision">
      <geom contype="1" conaffinity="1" group="0" density="0"
            priority="1" condim="6"/>
    </default>

    <default class="foot_capsule">
      <geom contype="1" conaffinity="1" group="0" density="0"
            priority="1" condim="6"/>
    </default>

    <!-- Leg Actuators Template -->
    <default class="leg_joint">
      <joint damping="5.0" armature="0.01"/>
      <position kp="200" forcelimited="true" forcerange="-150 150"/>
    </default>

    <!-- Arm Actuators Template -->
    <default class="arm_joint">
      <joint damping="1.5" armature="0.003"/>
      <position kp="30" forcelimited="true" forcerange="-30 30"/>
    </default>

    <!-- Torso/waist actuator template -->
